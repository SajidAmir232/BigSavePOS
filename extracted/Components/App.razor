<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="app.css?v=2.0" />
    <link rel="stylesheet" href="POSApp.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script>
        window.downloadBytes = function(name, bytes, type) { var blob = new Blob([new Uint8Array(bytes)], {type:type}); var a=document.createElement("a"); a.href=URL.createObjectURL(blob); a.download=name; a.click(); setTimeout(function(){URL.revokeObjectURL(a.href);},1000); };

        window.openInvoicePrint = function(html) {
            var w = window.open('', '_blank', 'width=800,height=600');
            w.document.write(html);
            w.document.close();
        };

        window.openBarcodePrint = function(name, barcode, price) {
            var w = window.open('', '_blank', 'width=420,height=300');
            if (!w) return;
            var bars = Array.from(barcode).map(function(ch) { return '<i style="display:inline-block;width:' + ((ch.charCodeAt(0) % 3) + 1) + 'px;height:54px;background:#111;margin-right:1px"></i>'; }).join('');
            w.document.write('<!doctype html><html><head><title>Barcode</title><style>body{font-family:Arial;text-align:center;padding:20px}.bars{height:58px;white-space:nowrap;overflow:hidden;margin:12px auto;width:280px}</style></head><body><strong>' + name + '</strong><div class="bars">' + bars + '</div><div>' + barcode + '</div><div>Rs ' + price + '</div><scr' + 'ipt>window.onload=function(){window.print();}</scr' + 'ipt></body></html>');
            w.document.close();
        };

        window.productScanner = {
            listener: null,
            root: null,
            attach: function(selector) {
                this.detach();
                var root = document.querySelector(selector);
                if (!root) return;
                var barcode = root.querySelector('[data-barcode-input]');
                var buffer = '';
                var lastTime = 0;
                var source = null;
                var originalValue = '';
                this.root = root;
                this.listener = function(event) {
                    var target = event.target;
                    if (!(target instanceof HTMLInputElement) || target === barcode) return;
                    if (event.key === 'Enter') {
                        if (buffer.length >= 6) {
                            event.preventDefault();
                            event.stopPropagation();
                            barcode.value = buffer;
                            barcode.dispatchEvent(new Event('input', {bubbles: true}));
                            barcode.focus();
                        }
                        buffer = '';
                        return;
                    }
                    if (event.key === 'Enter') {
                        var code = this.buffer.trim();
                        this.buffer = '';
                        if (code.length >= 4) dotnet.invokeMethodAsync('HandleGlobalBarcode', code);
                        return;
                    }
                    if (event.key.length !== 1 || event.ctrlKey || event.altKey || event.metaKey) return;
                    var now = performance.now();
                    if (source !== target || now - lastTime > 120) {
                        buffer = '';
                        source = target;
                        originalValue = target.value;
                    }
                    buffer += event.key;
                    if (buffer.length >= 2 && now - lastTime <= 120) {
                        event.preventDefault();
                        event.stopPropagation();
                        target.value = originalValue;
                        target.dispatchEvent(new Event('input', {bubbles: true}));
                        barcode.value = buffer;
                        barcode.dispatchEvent(new Event('input', {bubbles: true}));
                        barcode.focus();
                    }
                    lastTime = now;
                };
                root.addEventListener('keydown', this.listener, true);
            },
            detach: function() {
                if (this.root && this.listener) this.root.removeEventListener('keydown', this.listener, true);
                this.root = null;
                this.listener = null;
            }
        };

        window.globalScanner = {
            listener: null,
            buffer: '',
            lastTime: 0,
            attach: function(dotnet) {
                this.detach();
                this.listener = function(event) {
                    var target = event.target;
                    if (target && target.closest && (target.closest('#product-form-modal') || (target.matches && target.matches('input[placeholder^="Scan barcode"]')))) return;
                    if (event.key === 'F2' || (event.ctrlKey && event.key.toLowerCase() === 'n')) {
                        event.preventDefault();
                        dotnet.invokeMethodAsync('HandleGlobalShortcut');
                        return;
                    }
                    if (event.key.length !== 1 || event.ctrlKey || event.altKey || event.metaKey) return;
                    var now = performance.now();
                    if (now - this.lastTime > 120) this.buffer = '';
                    this.buffer += event.key;
                    this.lastTime = now;
                }.bind(this);
                document.addEventListener('keydown', this.listener, true);
            },
            detach: function() {
                if (this.listener) document.removeEventListener('keydown', this.listener, true);
                this.listener = null;
            }
        };

        window.offlineSync = {
            isOnline: function() { return navigator.onLine; },
            saveInvoice: function(json) {
                var pending = JSON.parse(localStorage.getItem('pos_pending_invoices') || '[]');
                var invoice = JSON.parse(json);
                pending.push(invoice);
                localStorage.setItem('pos_pending_invoices', JSON.stringify(pending));
            },
            getPendingInvoices: function() {
                return localStorage.getItem('pos_pending_invoices') || '[]';
            },
            getPendingCount: function() {
                var pending = JSON.parse(localStorage.getItem('pos_pending_invoices') || '[]');
                return pending.length;
            },
            removePendingInvoice: function(guid) {
                var pending = JSON.parse(localStorage.getItem('pos_pending_invoices') || '[]');
                pending = pending.filter(function(i) { return i.Guid !== guid; });
                localStorage.setItem('pos_pending_invoices', JSON.stringify(pending));
            },
            clearAll: function() {
                localStorage.removeItem('pos_pending_invoices');
            }
        };

        window.addEventListener('online', function() {
            Blazor.invokeMethodAsync('SyncOnlineStatus', true).catch(function(){});
        });
        window.addEventListener('offline', function() {
            Blazor.invokeMethodAsync('SyncOnlineStatus', false).catch(function(){});
        });
    </script>
</body>
</html>
