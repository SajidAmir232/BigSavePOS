@page "/data-tools"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@inject ExcelPosService Excel
@inject WebAuthService WebAuth
@inject IJSRuntime JS

<h2 style="font-size:16px;font-weight:600;">Excel Import / Export & Data Tools</h2>
<div class="card mb-3"><div class="card-header">Products Excel</div><p class="text-muted text-sm">Template supports barcode, SKU, category/subcategory, unit, cost/sale/wholesale prices, opening stock, minimum stock, expiry and brand. Existing products are updated by barcode within the selected branch.</p><div class="d-flex gap-2"><button class="btn btn-outline" @onclick="DownloadTemplate">Download Template</button><button class="btn btn-primary" @onclick="ExportProducts">Export Products</button></div></div>
<div class="card"><div class="card-header">Bulk Import</div><InputFile OnChange="SelectFile" accept=".xlsx" /><div class="text-muted text-sm mt-2">@fileName</div><div class="d-flex gap-2 mt-3"><button class="btn btn-outline" @onclick="Preview" disabled="@(!hasFile)">Validate / Preview</button><button class="btn btn-success" @onclick="Import" disabled="@(!hasFile)">Import</button></div>@if(errors.Any()){<div class="mt-3" style="background:#fee2e2;padding:10px;border-radius:6px"><b>Validation errors</b><ul>@foreach(var e in errors.Take(20)){<li>@e</li>}</ul></div>}@if(!string.IsNullOrEmpty(message)){<div class="mt-3 text-sm">@message</div>}</div>
@code{private IBrowserFile? file;private string fileName="No file selected",message="";private bool hasFile;private List<string> errors=new();private async Task SelectFile(InputFileChangeEventArgs e){file=e.File;fileName=file?.Name??"No file selected";hasFile=file!=null;errors.Clear();message="";}private async Task<byte[]> ReadFile(){if(file==null)throw new InvalidOperationException("Select an Excel file first.");using var ms=new MemoryStream();await file.OpenReadStream(10*1024*1024).CopyToAsync(ms);return ms.ToArray();}private async Task Preview(){try{errors.Clear();using var ms=new MemoryStream(await ReadFile());var r=Excel.ImportProducts(ms,WebAuth.CurrentUser!,true);errors=r.errors;message=errors.Any()?"Preview completed with errors.":"Preview passed validation.";}catch(Exception ex){message=ex.Message;}}private async Task Import(){try{errors.Clear();using var ms=new MemoryStream(await ReadFile());var r=Excel.ImportProducts(ms,WebAuth.CurrentUser!);errors=r.errors;message=$"Import completed. Added: {r.imported}, updated: {r.updated}, errors: {r.errors.Count}.";}catch(Exception ex){message=ex.Message;}}private async Task DownloadTemplate()=>await JS.InvokeVoidAsync("downloadBytes","OneBux_POS_Product_Template.xlsx",Excel.ProductTemplate(),"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");private async Task ExportProducts()=>await JS.InvokeVoidAsync("downloadBytes",$"POS_Products_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",Excel.ExportProducts(WebAuth.CurrentUser!),"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");}
