@page "/branches"
@rendermode InteractiveServer
@using POSApp.Data.Models
@inject BranchService BranchService
@inject AuthService Auth
@inject WebAuthService WebAuth
<h2 style="font-size:16px;font-weight:600;">Branches & User Assignment</h2>
@if(WebAuth.CurrentUser?.Role!="Admin"){<div class="card">Only Admin users can manage branches.</div>}else{<div class="card mb-3"><div class="card-header">Create Branch</div><div class="d-flex gap-2"><input class="form-control" @bind="name" placeholder="Branch name"/><input class="form-control" @bind="code" placeholder="Code"/><input class="form-control" @bind="address" placeholder="Address"/><button class="btn btn-primary" @onclick="Create">Create</button></div></div><div class="card"><div class="card-header">Active Branches</div><table><thead><tr><th>Name</th><th>Code</th><th>Address</th><th>Status</th></tr></thead><tbody>@foreach(var b in branches){<tr><td>@b.Name</td><td>@b.Code</td><td>@b.Address</td><td><span class="badge badge-green">Active</span></td></tr>}</tbody></table></div><div class="card mt-3"><div class="card-header">Assign User to Branch</div><div class="d-flex gap-2"><select class="form-control" @bind="userId"><option value="0">Select user</option>@foreach(var u in users){<option value="@u.Id">@u.Username (@u.Role)</option>}</select><select class="form-control" @bind="branchId"><option value="0">Select branch</option>@foreach(var b in branches){<option value="@b.Id">@b.Name</option>}</select><button class="btn btn-primary" @onclick="Assign">Assign</button></div>@if(!string.IsNullOrWhiteSpace(message)){<div class="mt-2 text-sm">@message</div>}</div>}
@code{private List<Branch> branches=new();private List<User> users=new();private string name="",code="",address="",message="";private int userId,branchId;protected override void OnInitialized(){if(WebAuth.CurrentUser?.Role=="Admin"){branches=BranchService.GetAll();users=Auth.GetAllUsers();}}private void Create(){try{BranchService.Save(new Branch{Name=name,Code=code.ToUpperInvariant(),Address=address},WebAuth.CurrentUser!);name=code=address="";branches=BranchService.GetAll();message="Branch created.";}catch(Exception ex){message=ex.Message;}}private void Assign(){try{BranchService.AssignUser(userId,branchId,WebAuth.CurrentUser!,false);message="User assigned to branch.";}catch(Exception ex){message=ex.Message;}}}
